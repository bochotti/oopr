\subsection{\command{\ht{OoprBreakpointsImpl-OoprBreakpointsRStudio-getFunctionSteps}{getFunctionSteps}}\hr{}getFunctionSteps}{
\subsection{Description}{
\lbr{}Gets the "steps" required for a line.
}

\subsection{Usage}{
\rc{\preformatted{getFunctionSteps(name, file, pkg, lines)}}
}

\subsection{Arguments}{
\ar{#1}{#2}\tabular{ll}{
\code{lines} \tab \code{list()} \br
A list of \code{integer(1L)} of the line numbers to be added.}
}

\subsection{Details}{
\lbr{}The trick here is to prefix the steps with \code{"oopr:"} as RStudio does
\emph{not} validate the \code{steps} field. The function setting the breakpoints
will know which breakpoints are for \code{oopr} classes.
}

\subsection{Returns}{
\lbr{}A \code{list} of
\code{list(name = character(1L), line = integer(1L), at = character(1L))},
where \code{at} is in the form \code{"oopr:line"} if relating to an \code{oopr} class.
}
}

